CLOUDFLARE_ACCOUNT_ID=your-account-id-here
CLOUDFLARE_API_TOKEN=your-token-here

# /admin にアクセスできる管理者のメールアドレス（カンマ区切り）。
# `make cf-secret` / `make cf-stage-secret` の secret になり、
# stage では `make cf-stage-access-setup` の Access ポリシーの許可リストにもなる。
# 空のまま stage の Access セットアップを実行すると、全員許可へフォールバックせず失敗する。
ADMIN_EMAILS=you@example.com

# Access アプリの AUD タグ。`make cf-access-setup` の出力を貼る（初回は空でよい）。
ACCESS_AUD=
